# AI_BACKEND selects the generation seam (app/seam.py):
#   gemini -> calls the Gemini API (needs GEMINI_API_KEY)
#   stub   -> canned deterministic output, no network/key needed (verifier & eval work fully offline)
AI_BACKEND=stub
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.6-flash

# Go backend base URL for T3 grounding fetchers. Optional: if unset or unreachable,
# grounding falls back to fixtures/ so the service still runs with no backend up.
GO_API_BASE_URL=http://localhost:8080/api/v1
GO_API_TIMEOUT_SECONDS=5

APP_PORT=8000
