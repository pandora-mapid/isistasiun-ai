# The generation seam (app/seam.py) picks a backend:
#   stub   -> canned deterministic output, no network/key needed (verifier & eval work fully offline)
#   gemini -> Gemini API (needs GEMINI_API_KEY)
#   groq   -> Groq OpenAI-compatible API (needs GROQ_API_KEY) — API-only deploy, no GPU
#   local  -> local OpenAI-compatible server, Ollama/vLLM (needs LOCAL_BASE_URL/LOCAL_MODEL) — uses the GPU
#
# AI_BACKENDS (plural, comma-separated) = an ordered fallback chain, tried left
# to right until one answers. Recommended: local first (free, no limit), then
# groq (per-minute free limit, recovers), then gemini LAST — Gemini's free tier
# is only ~20 requests/DAY, so it's a weak fallback, not a primary. Leave
# AI_BACKENDS empty to use the single AI_BACKEND instead. If the whole chain
# fails the answer degrades to a deterministic grounded template — the map
# never blocks on the model.
AI_BACKENDS=local,groq,gemini
AI_BACKEND=stub

# --- gemini ---
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.6-flash

# --- groq (VPS deploy, no GPU) ---
# Groq rotates its model catalog; if GROQ_MODEL 404s ("model_not_found"), pick a
# current one from GET https://api.groq.com/openai/v1/models (needs the key).
GROQ_API_KEY=changeme
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- local (Ollama/vLLM on the workstation GPU) ---
# Ollama default shown; for vLLM set LOCAL_BASE_URL=http://localhost:8000/v1 and LOCAL_API_KEY if required.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:14b
LOCAL_API_KEY=

# Timeout (seconds) for a single LLM generation call across all backends.
AI_REQUEST_TIMEOUT_SECONDS=30

# Go backend base URL for T3 grounding fetchers. Optional: if unset or unreachable,
# grounding falls back to fixtures/ so the service still runs with no backend up.
GO_API_BASE_URL=http://localhost:8080/api/v1
GO_API_TIMEOUT_SECONDS=5

APP_PORT=8000
